{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Cloud Burrito",
  "version": "0.2.7",
  "identifier": "app.cloudburrito.desktop",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": null
  },
  "app": {
    "windows": [
      { "title": "Cloud Burrito", "width": 1480, "height": 920, "minWidth": 1100, "minHeight": 700 }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "frame-src": "'none'",
        "img-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "capabilities": ["default"]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
